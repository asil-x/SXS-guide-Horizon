[{"id":1,"name":"Warrior","rank":1,"role":"Cận chiến","description":"Chiến binh mạnh mẽ với HP và DEF cao, chịu đòn tốt, giỏi truy kích cận chiến và phản đòn khi đỡ.","chain":["Warrior"],"techniques":["Leap Attack","Quadrant Slash","Wind Blade Slash","Diving Gale"],"charms":["Blade Tempest","Warrior's Essence","Feline Dance","Life Blessing"],"icon":"skills/classes/warrior.png"},{"id":2,"name":"Mage","rank":1,"role":"Pháp sư","description":"Pháp sư tầm xa gây sát thương phép lớn, đồng thời hỗ trợ bằng hồi máu, khống chế và triệu hồi.","chain":["Mage"],"techniques":["Cyclone","Ice Spike","Fireball","Iron Thorn"],"charms":["Unstable Aura","Elemental Mystery","Elemental Body","Tough Soul"],"icon":"skills/classes/mage.png"},{"id":3,"name":"Knight","rank":2,"role":"Tank","description":"Một \"pháo đài\" trong chiến đấu, dùng khiên và đỡ đòn để bảo vệ cả đội.","chain":["Warrior","Knight"],"techniques":["Guardian Ring","Mountain Collapse","Frostbite Blossom","Whirlwind Slash"],"charms":["Defensive Assault","Ripple Impact","Pursuit of Victory","Eye for an Eye"],"icon":"skills/classes/knight.png"},{"id":4,"name":"Duelist","rank":2,"role":"Cận chiến","description":"Chiến binh tốc độ sống vì những pha bộc phát, không gì cản được trên đường chinh phục.","chain":["Warrior","Duelist"],"techniques":["Boiling Bloodlust","Gravity Pull","Whirlwind Slash","Sunset Sword"],"charms":["Insightful Eye","Crit Mastery","Blade Tempest","Blade of Lament"],"icon":"skills/classes/duelist.png"},{"id":5,"name":"Sorcerer","rank":2,"role":"Pháp sư","description":"Bậc thầy skill diện rộng, gieo rắc nỗi sợ bằng sức mạnh huỷ diệt.","chain":["Mage","Sorcerer"],"techniques":["Cyclone","Water Assault","Ice Spike","Frosty Nova"],"charms":["Insight","Water to Ice","Void Bubble","Dew's Blessing"],"icon":"skills/classes/sorcerer.png"},{"id":6,"name":"Sage","rank":2,"role":"Hỗ trợ","description":"Bậc thầy chiến thuật, xoay chuyển chiến trường bằng hồi máu, khống chế và triệu hồi.","chain":["Mage","Sage"],"techniques":["Treantling Summon","Stonechief Summon","Void Blessing","Radiant Restoration"],"charms":["Soul Spark","Soul Impact","Tough Soul","Elemental Body"],"icon":"skills/classes/sage.png"},{"id":7,"name":"Paladin","rank":3,"role":"Tank","description":"Trừng phạt kẻ thù bằng hào quang thánh thiện và đứng vững làm lá chắn cho đồng đội.","chain":["Warrior","Knight","Paladin"],"techniques":["Luminous Shield","Guardian Ring","Desperate Protection","Heart of Challenge"],"charms":["Block Awareness","Block Mastery","Rebound","Iron Fortress"],"icon":"skills/classes/paladin.png"},{"id":8,"name":"Berserker","rank":3,"role":"Cận chiến","description":"Lấy những đòn tấn công dữ dội làm khiên, nghiền nát ý chí chiến đấu của kẻ địch!","chain":["Warrior","Duelist","Berserker"],"techniques":["Hunter's Judgment","Sunset Sword","Fire Slash","Whirlwind Slash"],"charms":["Insightful Eye","Blade of Judgment","Indomitable Will","Blade Siphon"],"icon":"skills/classes/berserker.png"},{"id":9,"name":"Archmage","rank":3,"role":"Pháp sư","description":"Giải phóng nguyên tố nguyên thuỷ của thế giới! Nhấn chìm kẻ thù trong cơn bão mana cho tới khi chỉ còn tro bụi.","chain":["Mage","Sorcerer","Archmage"],"techniques":["Aqua Vortex","Wind's Delight","Meteoric Flames","Lightning Chain"],"charms":["Elemental Harmony","Mana Surge","Unstable Aura","Lightning Mystery"],"icon":"skills/classes/archmage.png"},{"id":10,"name":"Arcanist","rank":3,"role":"Hỗ trợ","description":"Dùng sức mạnh triệu hồi và charm để điều khiển cục diện trận đấu!","chain":["Mage","Sage","Arcanist"],"techniques":["Weakening Hex","Abyssal Hand","Dark Bullet","Shadow of Termination"],"charms":["Shadow Erosion","Shadow Vengeance","Linked Misfortune","Night's Blessing"],"icon":"skills/classes/arcanist.png"},{"id":11,"name":"Guardian","rank":4,"role":"Tank","description":"Lấy băng làm khiên và kiếm. Đứng vững, bạn là người bảo hộ bất khuất trước mọi mối đe doạ.","chain":["Warrior","Knight","Paladin","Guardian"],"techniques":["Guardian Ring","Swirling Blade","Seismic Tide","Star Shattering Slash"],"charms":["Block Awareness","Defensive Assault","Ripple Impact","Pursuit of Victory"],"icon":"skills/classes/guardian.png"},{"id":12,"name":"Conqueror","rank":4,"role":"Cận chiến","description":"Để cơn cuồng nộ chiến đấu bùng cháy trong huyết quản! Mở đường bằng chinh phạt và huỷ diệt không ngừng.","chain":["Warrior","Duelist","Berserker","Conqueror"],"techniques":["Hunter's Judgment","Sunset Sword","Blade Storm","Eclipse Slash"],"charms":["Insightful Eye","Blade of Judgment","Blazing Momentum","Blade Siphon"],"icon":"skills/classes/conqueror.png"},{"id":13,"name":"Destroyer","rank":4,"role":"Pháp sư","description":"Điều khiển nguyên tố, làm chủ vũ điệu bất ổn giữa sáng tạo và huỷ diệt.","chain":["Mage","Sorcerer","Archmage","Destroyer"],"techniques":["Flickering Stars","Starlight Burst","Thunder of Judgment","Divine Wrath"],"charms":["Rapid Cast","Radiant Sear","Lightning Mystery","Incarnation of Light"],"icon":"skills/classes/destroyer.png"},{"id":14,"name":"Dominator","rank":4,"role":"Hỗ trợ","description":"Chỉ huy đạo quân triệu hồi, nghiêng cán cân chiến thắng!","chain":["Mage","Sage","Arcanist","Dominator"],"techniques":["Weakening Hex","Abyssal Hand","Dark Starburst","Shadow of Termination"],"charms":["Shadow Erosion","Shadow Vengeance","Linked Misfortune","Aberrancy"],"icon":"skills/classes/dominator.png"},{"id":15,"name":"Templar","rank":5,"role":"Tank","description":"Lá chắn thiêng liêng, được che chở bởi ánh sáng thánh không lay chuyển.","chain":["Warrior","Knight","Paladin","Guardian","Templar"],"techniques":["Guardian Ring","Desperate Protection","Heart of Challenge","Last Stand"],"charms":["Healing Shift","Soul Protection","Iron Will","Holy Aegis"],"icon":"skills/classes/templar.png"},{"id":16,"name":"Ravager","rank":5,"role":"Cận chiến","description":"Tinh thần rực cháy và dòng máu sôi sục hoà làm một, thành sức mạnh kết thúc mọi thứ.","chain":["Warrior","Duelist","Berserker","Conqueror","Ravager"],"techniques":["Hunter's Judgment","Solaris Storm","Whirlwind Slash","Sunset Sword"],"charms":["Tactical Adaptation","Blazing Momentum","Tempest Edge","Blade of Judgment"],"icon":"skills/classes/ravager.png"},{"id":17,"name":"Magister","rank":5,"role":"Pháp sư","description":"Nắm tai hoạ trong tay, thuỷ triều nguyên tố dâng lên, biến tất cả thành tro tàn.","chain":["Mage","Sorcerer","Archmage","Destroyer","Magister"],"techniques":["Light Burst","Starlight Burst","Thunder of Judgment","Divine Wrath"],"charms":["Thunderbolt Mark","Thunder Judgment","Radiant Sear","Rapid Cast"],"icon":"skills/classes/magister.png"},{"id":18,"name":"Prophet","rank":5,"role":"Hỗ trợ","description":"Nhìn xuyên màn sương định mệnh, dẫn dắt tạo hoá khi ánh sáng bừng lên lần nữa.","chain":["Mage","Sage","Arcanist","Dominator","Prophet"],"techniques":["Rejuvenating Rain","Healing Touch","Radiant Rhythm","Radiant Restoration"],"charms":["Phantom Light","Overhealing","Rejuvenating Elixir","Resurrection"],"icon":"skills/classes/prophet.png"},{"id":19,"name":"Justicar","rank":6,"role":"Tank","description":"Dưới bầu trời vô tận, trước cơn sóng của vực thẳm, họ rèn ý chí thần thánh thành tấm khiên không thể phá vỡ.","chain":["Warrior","Knight","Paladin","Guardian","Templar","Justicar"],"techniques":["Twin Radiance Shield","Desperate Protection","Heart of Challenge","Last Stand"],"charms":["Healing Shift","Soul Protection","Iron Will","Holy Aegis"],"icon":"skills/classes/justicar.png"},{"id":20,"name":"Marauder","rank":6,"role":"Cận chiến","description":"Một nhát chém của lưỡi kiếm nguyền rủa, kẻ địch đã rơi vào địa ngục chốc lát trước khi kịp thấy đòn đánh.","chain":["Warrior","Duelist","Berserker","Conqueror","Ravager","Marauder"],"techniques":["Raining Blades","Shattering Dance","Eclipse Slash","Shadowflash Dance"],"charms":["Indomitable Will","Blade of Judgment","Grim Pursuit","Razor Momentum"],"icon":"skills/classes/marauder.png"},{"id":21,"name":"Arcanarch","rank":6,"role":"Pháp sư","description":"Chỉ một hơi thở, nguyên tố bùng nổ thành ngọn lửa bất tận thiêu rụi mọi thứ trên đường đi.","chain":["Mage","Sorcerer","Archmage","Destroyer","Magister","Arcanarch"],"techniques":["Tideburst","Frost Thorn","Frigid Spike","Judgment Thunder"],"charms":["Radiant Warp","Overload Protection","Surging Tide","Riptide"],"icon":"skills/classes/arcanarch.png"},{"id":22,"name":"Hierarch","rank":6,"role":"Hỗ trợ","description":"Vén màn những chân lý trói buộc thế giới, họ chỉ huy bóng tối trỗi dậy và thống trị muôn linh hồn.","chain":["Mage","Sage","Arcanist","Dominator","Prophet","Hierarch"],"techniques":["Rock Rex Summon","Thalasson Summon","Phantom Summon","Flamewyrm Summon"],"charms":["Summoner's Frenzy","Summoning Pact","Soulweave","Eidolon Whisper"],"icon":"skills/classes/hierarch.png"},{"id":23,"name":"Vindicator","rank":7,"role":"Tank","description":"Tắm trong hào quang rực cháy, họ đứng vững như bức tường vinh quang không thể xuyên thủng.","chain":["Warrior","Knight","Paladin","Guardian","Templar","Justicar","Vindicator"],"techniques":["Aether Rush","Warforged Edge","Flurry Strike","Frost Protection"],"charms":["Soul Protection","Holy Aegis","Power of Retribution","Fortified Shell"],"icon":"skills/classes/compass/class-23.webp"},{"id":24,"name":"Doomreaver","rank":7,"role":"Cận chiến","description":"Xé toạc bầu trời, giáng các vì sao xuống, không để lại sinh vật nào trên đường đi.","chain":["Warrior","Duelist","Berserker","Conqueror","Ravager","Marauder","Doomreaver"],"techniques":["Sinseal","Hellfire Fist","Ignition Strike","Starfire Annihilation"],"charms":["Indomitable Will","Piercing Assault","Starfire Edge","Ironclad"],"icon":"skills/classes/compass/class-24.webp"},{"id":25,"name":"Thaumaturge","rank":7,"role":"Pháp sư","description":"Những câu chú cấm kỵ gọi mời hư không vô tận, nuốt chửng mọi kẻ dám đứng chắn đường.","chain":["Mage","Sorcerer","Archmage","Destroyer","Magister","Arcanarch","Thaumaturge"],"techniques":["Formation Breaker","Judgment Thunder","Void Lightwave","Lightning Grid"],"charms":["Radiant Sear","Thunderbolt Mark","Glare Fusion","Gale Scar"],"icon":"skills/classes/compass/class-25.webp"},{"id":26,"name":"Demiurge","rank":7,"role":"Hỗ trợ","description":"Toàn tri toàn năng, họ dệt nên vận mệnh tạo hoá và cai trị thế giới bằng quyền uy tuyệt đối.","chain":["Mage","Sage","Arcanist","Dominator","Prophet","Hierarch","Demiurge"],"techniques":["Thalasson Summon","Flamewyrm Summon","Flora Summon","Wraithguard Summon"],"charms":["Soulweave","Eidolon Whisper","Deathrattle","Soulbinder"],"icon":"skills/classes/compass/class-26.webp"},{"id":27,"name":"Vindicator VIII","rank":8,"role":"Tank","description":"Nghề thứ 8 của nhánh Vindicator, ra mắt cùng Season 6. Tên trong game chưa được công bố nên tạm gọi là Vindicator VIII.","chain":["Warrior","Knight","Paladin","Guardian","Templar","Justicar","Vindicator","Vindicator VIII"],"techniques":["Lucent Edge","Charged Slash","Radiant Roar","Lumen Nova"],"charms":["Skyglow","Fortified Shell","Energy Flux","Luminous Restoration"],"icon":"skills/classes/compass/class-27.webp"},{"id":28,"name":"Doomreaver VIII","rank":8,"role":"Cận chiến","description":"Nghề thứ 8 của nhánh Doomreaver, ra mắt cùng Season 6. Tên trong game chưa được công bố nên tạm gọi là Doomreaver VIII.","chain":["Warrior","Duelist","Berserker","Conqueror","Ravager","Marauder","Doomreaver","Doomreaver VIII"],"techniques":["Sinseal","Tempest Call","Skyfall Gale","Phantom Blitz"],"charms":["Indomitable Will","Windless Lord","Bladegale Conflux","Zephyr Cascade"],"icon":"skills/classes/compass/class-28.webp"},{"id":29,"name":"Thaumaturge VIII","rank":8,"role":"Pháp sư","description":"Nghề thứ 8 của nhánh Thaumaturge, ra mắt cùng Season 6. Tên trong game chưa được công bố nên tạm gọi là Thaumaturge VIII.","chain":["Mage","Sorcerer","Archmage","Destroyer","Magister","Arcanarch","Thaumaturge","Thaumaturge VIII"],"techniques":["Tideburst","Frostfall Assault","Rime Shackle","Frost Shatter"],"charms":["Riptide","Frost Undertow","Fluidshift","Frostflow Pact"],"icon":"skills/classes/compass/class-29.webp"},{"id":30,"name":"Demiurge VIII","rank":8,"role":"Hỗ trợ","description":"Nghề thứ 8 của nhánh Demiurge, ra mắt cùng Season 6. Tên trong game chưa được công bố nên tạm gọi là Demiurge VIII.","chain":["Mage","Sage","Arcanist","Dominator","Prophet","Hierarch","Demiurge","Demiurge VIII"],"techniques":["Decoy Clone","Ravenous Curse","Darkveil Formation","Triune Salvo"],"charms":["Shadow Vengeance","Mantra of Blessings","Cursed Link","Hexecho"],"icon":"skills/classes/compass/class-30.webp"}]
